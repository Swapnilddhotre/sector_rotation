//@version=6
indicator("Wyckoff Accumulation Events", overlay = true, max_labels_count = 500, max_lines_count = 500)

// ─── Inputs ───────────────────────────────────────────────────────────────────
int   lookback    = input.int  (20,    "Pivot Lookback",           minval = 5,     maxval = 50)
float volMult     = input.float(1.5,   "Volume Spike Multiplier",  minval = 1.0,   step   = 0.1)
int   volLen      = input.int  (20,    "Volume MA Length",         minval = 5,     maxval = 50)
float rangeBuf    = input.float(0.02,  "Range Buffer (% of price)",minval = 0.001, step   = 0.001)
bool  showLines   = input.bool (true,  "Show Support/Resistance Lines")
bool  showLabels  = input.bool (true,  "Show Event Labels")

// ─── Colours ──────────────────────────────────────────────────────────────────
color c_ps  = color.new(color.orange, 0)
color c_sc  = color.new(color.red,    0)
color c_ar  = color.new(color.lime,   0)
color c_st  = color.new(color.yellow, 0)
color c_sp  = color.new(color.purple, 0)
color c_lps = color.new(color.aqua,   0)
color c_sos = color.new(color.green,  0)
color c_bu  = color.new(color.blue,   0)
color c_mu  = color.new(color.white,  0)

// ─── Helpers ──────────────────────────────────────────────────────────────────
float volMA      = ta.sma(volume, volLen)
bool  isVolSpike = volume > volMA * volMult
bool  isWideBar  = (high - low) > ta.atr(14) * 1.5

float pivotHi = ta.pivothigh(high, lookback, lookback)
float pivotLo = ta.pivotlow (low,  lookback, lookback)

// ─── Key levels ───────────────────────────────────────────────────────────────
var float scLevel    = na
var float arLevel    = na
var float stLevel    = na
var float creekLevel = na

// ─── State machine (0 = watching … 9 = markup) ────────────────────────────────
var int  phase    = 0
var bool ps_done  = false
var bool sc_done  = false
var bool ar_done  = false
var bool st_done  = false
var bool sp_done  = false
var bool lps_done = false
var bool sos_done = false
var bool bu_done  = false
var bool mu_done  = false

// Inline helper: price within buffer of a level
inRange(float p, float lvl, float buf) =>
    not na(lvl) and math.abs(p - lvl) / lvl <= buf

// ─── PS — Preliminary Support ────────────────────────────────────────────────
bool psCondition = phase == 0 and not na(pivotLo) and isVolSpike and close < close[lookback * 3]

if psCondition and not ps_done
    ps_done := true
    phase   := 1
    scLevel := low[lookback]
    if showLabels
        label.new(bar_index[lookback], low[lookback], "PS",
                  color = c_ps, textcolor = color.white,
                  style = label.style_label_up, size = size.small)

// ─── SC — Selling Climax ─────────────────────────────────────────────────────
bool scCondition = (phase == 1 and not na(pivotLo) and isVolSpike and isWideBar and
                   (close - low[lookback]) / (high[lookback] - low[lookback] + 0.0001) > 0.4)

if scCondition and not sc_done
    sc_done  := true
    phase    := 2
    scLevel  := low[lookback]
    if showLabels
        label.new(bar_index[lookback], low[lookback], "SC",
                  color = c_sc, textcolor = color.white,
                  style = label.style_label_up, size = size.normal)
    if showLines
        line.new(bar_index[lookback], low[lookback],
                 bar_index[lookback] + 60, low[lookback],
                 color = color.new(c_sc, 50), style = line.style_dashed, width = 1)

// ─── AR — Automatic Rally ────────────────────────────────────────────────────
bool arCondition = (phase == 2 and not na(pivotHi) and
                   high[lookback] > scLevel * (1 + rangeBuf * 5) and
                   volume[lookback] < volume[lookback * 2])

if arCondition and not ar_done
    ar_done    := true
    phase      := 3
    arLevel    := high[lookback]
    creekLevel := high[lookback]
    if showLabels
        label.new(bar_index[lookback], high[lookback], "AR",
                  color = c_ar, textcolor = color.black,
                  style = label.style_label_down, size = size.normal)
    if showLines
        line.new(bar_index[lookback], high[lookback],
                 bar_index[lookback] + 60, high[lookback],
                 color = color.new(c_ar, 50), style = line.style_dashed, width = 1)

// ─── ST — Secondary Test ─────────────────────────────────────────────────────
bool stCondition = (phase == 3 and not na(pivotLo) and
                   inRange(low[lookback], scLevel, rangeBuf * 3) and
                   volume[lookback] < volMA[lookback])

if stCondition and not st_done
    st_done  := true
    phase    := 4
    stLevel  := low[lookback]
    if showLabels
        label.new(bar_index[lookback], low[lookback], "ST",
                  color = c_st, textcolor = color.black,
                  style = label.style_label_up, size = size.small)

// ─── Spring / Shakeout ───────────────────────────────────────────────────────
bool springCondition = (phase == 4 and not na(pivotLo) and
                       low[lookback]   < scLevel and
                       close[lookback] > scLevel and
                       volume[lookback] < volMA[lookback] * 1.2)

if springCondition and not sp_done
    sp_done := true
    phase   := 5
    if showLabels
        label.new(bar_index[lookback], low[lookback], "Spring",
                  color = c_sp, textcolor = color.white,
                  style = label.style_label_up, size = size.small)

// ─── LPS — Last Point of Support ─────────────────────────────────────────────
bool lpsCondition = ((phase == 4 or phase == 5) and not na(pivotLo) and
                    low[lookback] > scLevel and
                    (na(stLevel) or low[lookback] >= stLevel * (1 - rangeBuf)) and
                    volume[lookback] < volMA[lookback])

if lpsCondition and not lps_done
    lps_done := true
    phase    := 6
    if showLabels
        label.new(bar_index[lookback], low[lookback], "LPS",
                  color = c_lps, textcolor = color.black,
                  style = label.style_label_up, size = size.small)

// ─── SOS — Sign of Strength ──────────────────────────────────────────────────
bool sosCondition = (phase == 6 and not na(pivotHi) and
                    high[lookback]  > creekLevel and isVolSpike and
                    close[lookback] > open[lookback])

if sosCondition and not sos_done
    sos_done := true
    phase    := 7
    if showLabels
        label.new(bar_index[lookback], high[lookback], "SOS",
                  color = c_sos, textcolor = color.white,
                  style = label.style_label_down, size = size.normal)

// ─── BU — Back-Up to the Creek ───────────────────────────────────────────────
bool buCondition = (phase == 7 and not na(pivotLo) and
                   inRange(low[lookback], creekLevel, rangeBuf * 4) and
                   volume[lookback] < volMA[lookback])

if buCondition and not bu_done
    bu_done := true
    phase   := 8
    if showLabels
        label.new(bar_index[lookback], low[lookback], "BU",
                  color = c_bu, textcolor = color.white,
                  style = label.style_label_up, size = size.small)

// ─── Markup Continuation ─────────────────────────────────────────────────────
bool muCondition = (phase == 8 and not na(pivotHi) and
                   high[lookback]   > creekLevel * (1 + rangeBuf * 5) and
                   close[lookback]  > open[lookback] and
                   volume[lookback] > volMA[lookback])

if muCondition and not mu_done
    mu_done := true
    phase   := 9
    if showLabels
        label.new(bar_index[lookback], high[lookback], "Markup",
                  color = c_mu, textcolor = color.black,
                  style = label.style_label_down, size = size.normal)

// ─── Background shading ───────────────────────────────────────────────────────
color bgColor = switch phase
    0 => color.new(color.gray,   92)
    1 => color.new(color.orange, 88)
    2 => color.new(color.red,    88)
    3 => color.new(color.yellow, 88)
    4 => color.new(color.yellow, 85)
    5 => color.new(color.purple, 85)
    6 => color.new(color.teal,   85)
    7 => color.new(color.green,  85)
    8 => color.new(color.blue,   88)
    9 => color.new(color.lime,   85)
    => na

bgcolor(bgColor, title = "Phase Background")

// ─── Volume colouring ─────────────────────────────────────────────────────────
color volColor = isVolSpike ? color.new(color.red, 20) : color.new(color.gray, 40)
plot(volume, "Volume", color = volColor, style = plot.style_columns)

// ─── Status table ─────────────────────────────────────────────────────────────
var table tbl = table.new(position.top_right, 2, 10,
                           border_width = 1, border_color = color.gray,
                           frame_color  = color.gray, frame_width = 1)

array<string> phaseNames = array.from("Watching","PS","SC","AR","ST","Spring","LPS","SOS","BU","Markup")

_tblRow(int row, string lbl, bool done) =>
    table.cell(tbl, 0, row, lbl,        text_color = color.white, text_size = size.tiny)
    table.cell(tbl, 1, row, done ? "✓" : "–",
               bgcolor    = done ? color.new(color.green, 50) : color.new(color.gray, 70),
               text_color = color.white, text_size = size.tiny)

if barstate.islast
    table.cell(tbl, 0, 0, "Wyckoff Phase",
               bgcolor = color.new(color.gray, 30), text_color = color.white, text_size = size.small)
    table.cell(tbl, 1, 0, array.get(phaseNames, phase),
               bgcolor = color.new(color.blue, 30), text_color = color.white, text_size = size.small)
    _tblRow(1, "PS",     ps_done)
    _tblRow(2, "SC",     sc_done)
    _tblRow(3, "AR",     ar_done)
    _tblRow(4, "ST",     st_done)
    _tblRow(5, "Spring", sp_done)
    _tblRow(6, "LPS",    lps_done)
    _tblRow(7, "SOS",    sos_done)
    _tblRow(8, "BU",     bu_done)
    _tblRow(9, "Markup", mu_done)
